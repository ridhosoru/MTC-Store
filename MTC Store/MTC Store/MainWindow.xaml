<Window x:Class="MTC_Store.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:MTC_Store"
        Height="720" Width="1280" Background="Transparent" ResizeMode="NoResize" 
        WindowStartupLocation="CenterScreen" WindowStyle="None" AllowsTransparency="True">

    <Border Background="#154D71" CornerRadius="50" BorderBrush="AntiqueWhite" Padding="20"
            MouseDown="Border_MouseDown">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="800"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Label Content="Welcome To MTC Store" HorizontalAlignment="Left" 
                   Margin="26,139,0,0" VerticalAlignment="Top" Height="83" 
                   Width="724" FontSize="60" Foreground="White" FontFamily="Segoe UI Black"/>
            <Label Content="Getting Started" HorizontalAlignment="Left" 
                Margin="197,249,0,0" VerticalAlignment="Top" Height="83" 
                Width="382" FontSize="48" Foreground="White" FontFamily="Segoe UI Black"/>
            <Label Content="This application functions to monitor store activity" HorizontalAlignment="Left" VerticalAlignment="Top" Height="52" 
                Width="519" FontSize="24" Foreground="White" FontFamily="Segoe UI Light" Margin="151,410,0,0"/>
            <Label Content="contact email yohanesridho70@gmail.com if there are any problems" HorizontalAlignment="Left" VerticalAlignment="Top" Height="52" 
                Width="712" FontSize="24" Foreground="White" FontFamily="Segoe UI Light" Margin="40,462,0,0"/>
            <Border/>
            <Border Background="White" Margin="20,89,0,79" Grid.Column="1" CornerRadius="50">

            </Border>
            <Label Content="Login" Margin="192,95,148,523" FontSize="36" FontFamily="Segoe UI Semibold" Grid.Column="1"/>
            <Label Content="Register" Margin="178,308,118,310" FontSize="36" FontFamily="Segoe UI Semibold" Grid.Column="1"/>
            <Label Content="Username" Margin="54,165,274,478" FontSize="22" FontFamily="Segoe UI Semibold" Grid.Column="1"/>
            <Label Content="Password" Margin="54,220,281,423" FontSize="22" FontFamily="Segoe UI Semibold" Grid.Column="1"/>
            <TextBox TextWrapping="Wrap" Margin="176,177,64,483" Grid.Column="1"/>
            <PasswordBox Grid.Column="1" HorizontalAlignment="Left" Margin="176,230,0,0" VerticalAlignment="Top" Width="200"/>
            <Label Content="Username" Margin="60,375,268,268" FontSize="22" FontFamily="Segoe UI Semibold" Grid.Column="1"/>
            <Label Content="Password" Margin="60,417,268,226" FontSize="22" FontFamily="Segoe UI Semibold" Grid.Column="1" RenderTransformOrigin="0.795,1.784"/>
            <Label Content="Email" Margin="60,459,268,184" FontSize="22" FontFamily="Segoe UI Semibold" Grid.Column="1" RenderTransformOrigin="0.795,1.784"/>
            <Label Content="Verif" Margin="60,506,268,137" FontSize="22" FontFamily="Segoe UI Semibold" Grid.Column="1" RenderTransformOrigin="0.795,1.784"/>
            <Button Grid.Column="1" Content="Login" HorizontalAlignment="Left" Margin="226,266,0,0" VerticalAlignment="Top" Height="24" Width="68"/>
            <TextBox TextWrapping="Wrap" Margin="182,384,58,276" Grid.Column="1"/>
            <PasswordBox Grid.Column="1" HorizontalAlignment="Left" Margin="182,427,0,0" VerticalAlignment="Top" Width="200"/>
            <TextBox TextWrapping="Wrap" Margin="184,470,58,190" Grid.Column="1"/>
            <TextBox TextWrapping="Wrap" Margin="184,516,118,144" Grid.Column="1"/>
            <Button Grid.Column="1" Content="Verif" HorizontalAlignment="Left" Margin="334,513,0,0" VerticalAlignment="Top" Height="24" Width="48"/>
            <Button x:Name="RegisterBtn" Grid.Column="1" Content="Register" HorizontalAlignment="Left" Margin="224,558,0,0" VerticalAlignment="Top" Height="24" Width="68" RenderTransformOrigin="-0.86,2.396"/>
        </Grid>
    </Border>

</Window>
